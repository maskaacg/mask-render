 "lineas": [
  {
   "id": "l01",
   "fase": "intro",
   "texto": "Hotel Miramar, de madrugada. El ascensor se ha parado con gente dentro, y su aguja está rota."
  },
  {
   "id": "l02",
   "fase": "intro",
   "texto": "El portero lo vio salir de la planta uno. Para abrirlo, tienes que saber en qué planta está."
  },
  {
   "id": "l03",
   "fase": "enunciado",
   "texto": "Tarda ocho segundos por planta. Por el camino paró una sola vez, y abrió las puertas seis segundos."
  },
  {
   "id": "l04",
   "fase": "enunciado",
   "texto": "El viaje entero duró treinta segundos. El hotel solo tiene tres plantas."
  },
  {
   "id": "l05",
   "fase": "enunciado",
   "texto": "¿Dónde hizo la parada, y en qué planta se quedó?"
  },
  {
   "id": "l06",
   "fase": "solucion",
   "texto": "Paró en la tres y se quedó en la dos."
  },
  {
   "id": "l07",
   "fase": "solucion",
   "texto": "Si para en la dos: ocho segundos, seis de puertas y ocho hasta la tres o la uno. Veintidós. No llega."
  },
  {
   "id": "l08",
   "fase": "solucion",
   "texto": "Si para en la tres: dieciséis de subida, seis de puertas… y le quedan ocho segundos. Una planta: baja a la dos."
  },
  {
   "id": "l09",
   "fase": "solucion",
   "texto": "Volver a la uno serían dieciséis más: treinta y ocho. Solo encaja la dos."
  },
  {
   "id": "l10",
   "fase": "cta",
   "texto": "¿Lo pillaste antes de la cuenta atrás? Cuéntalo en los comentarios."
  },
  {
   "id": "l11",
   "fase": "cta",
   "texto": "Y suscríbete: el lunes empieza otra semana de habitaciones."
  }
 ],
